#
# SETUP INSTRUCTIONS:
#   1. Copy this file:        cp .env.example .env
#   2. Get a free API key:    https://aistudio.google.com/app/apikey
#   3. Paste your key below:  GOOGLE_API_KEY=your_actual_key_here
#   4. Save the file.
#
# The .env file is listed in .gitignore — it will NOT be committed to git.
# Never share or commit your API key!
# ─────────────────────────────────────────────────────────────

# Your Google AI Studio API key (free, no credit card needed)
GOOGLE_API_KEY=your_google_api_key_here
